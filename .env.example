# Copy this file to .env.local and paste the values from Supabase.
# .env.local stays on your machine. Do not commit it.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Settings → API Keys → Publishable key
# Legacy dashboards label the same key "anon" / "public".
# Safe in the browser. Row Level Security still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Project Settings → API Keys → Secret key
# Legacy dashboards label the same key "service_role".
# Server only. Do not add NEXT_PUBLIC_ to this name.
SUPABASE_SECRET_KEY=your-secret-key

# Optional. Structured spreadsheets are parsed in code. The model is not called unless both values are set.
OPENAI_API_KEY=
AI_DOCUMENT_ANALYSIS=false

# Left unset until the university worker exists. Writes stay off unless all three are explicit.
REDIS_URL=
REAL_PORTAL_WRITES=false
READ_ONLY_MODE=true
DRY_RUN=true
UNIVERSITY_SESSION_ENCRYPTION_KEY=

# Local UniPilot Agent. The agent binds to 127.0.0.1 only.
# University passwords are not stored. Writes stay off.
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:47321
UNIPILOT_APP_URL=http://localhost:3000
LOCAL_AGENT_ENABLED=true
UNIVERSITY_READ_ENABLED=true
ASSESSMENT_WRITE_ENABLED=false
MARKS_WRITE_ENABLED=false
